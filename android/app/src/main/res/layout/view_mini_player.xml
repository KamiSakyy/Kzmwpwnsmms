<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mini_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_above="@id/bottom_nav"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="6dp"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp">
        <ImageView android:id="@+id/mini_cover" android:layout_width="42dp" android:layout_height="42dp" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="10dp">
            <TextView android:id="@+id/mini_title" style="@style/Text.Row" android:maxLines="1" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/mini_artist" style="@style/Text.Row.Meta" android:maxLines="1" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView android:id="@+id/mini_time" style="@style/Text.Row.Meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="6dp" />
        <ImageView android:id="@+id/mini_play" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/ic_play" android:contentDescription="@string/action_play_all" />
        <ImageView android:id="@+id/mini_next" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/ic_play" android:rotation="0" android:contentDescription="@null" />
    </LinearLayout>

    <SeekBar android:id="@+id/mini_seek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="1000" android:paddingStart="12dp" android:paddingEnd="12dp" />
</LinearLayout>
