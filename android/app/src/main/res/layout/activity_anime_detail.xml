<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
        <ImageView android:id="@+id/back" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:src="@drawable/ic_home" android:contentDescription="@null" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp">
        <ImageView android:id="@+id/poster" android:layout_width="132dp" android:layout_height="190dp" android:scaleType="centerCrop" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
            <TextView android:id="@+id/title" style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="3" android:ellipsize="end" />
            <TextView android:id="@+id/sub" style="@style/Text.Row.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/play_all" android:text="@string/action_play_all" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <com.google.android.material.button.MaterialButton android:id="@+id/shuffle_all" style="@style/Widget.Material3.Button.TonalButton" android:text="@string/action_shuffle" android:layout_marginStart="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/description" style="@style/Text.Row.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:layout_marginTop="12dp" android:maxLines="4" android:ellipsize="end" />

    <ProgressBar android:id="@+id/loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
    <TextView android:id="@+id/empty" style="@style/Text.Row.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="20dp" android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingBottom="16dp" />
</LinearLayout>
