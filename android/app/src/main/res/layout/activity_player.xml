<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:paddingBottom="24dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
                <ImageView android:id="@+id/btn_close" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:src="@drawable/ic_home" android:contentDescription="@null" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <ImageView android:id="@+id/btn_queue" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:src="@drawable/ic_library" android:contentDescription="@null" />
            </LinearLayout>

            <!-- Обложка (показывается в аудио-режиме) -->
            <ImageView android:id="@+id/cover" android:layout_width="300dp" android:layout_height="300dp" android:scaleType="centerCrop" android:layout_marginTop="8dp" android:contentDescription="@null" />

            <!-- Видео-поверхность: включается только по кнопке «Видео» -->
            <FrameLayout android:id="@+id/video_wrap" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <androidx.media3.ui.PlayerView
                    android:id="@+id/video"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:visibility="gone"
                    app:use_controller="false"
                    app:resize_mode="fit"
                    app:surface_type="surface_view" />
            </FrameLayout>

            <TextView android:id="@+id/title" style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:layout_marginTop="16dp" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/artist" style="@style/Text.Row" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:textColor="@color/on_surface_variant" />
            <TextView android:id="@+id/sub" style="@style/Text.Row.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:layout_marginTop="2dp" />

            <TextView android:id="@+id/time" style="@style/Text.Row.Meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:layout_marginTop="12dp" />
            <SeekBar android:id="@+id/seek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="1000" android:paddingHorizontal="16dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                <ImageView android:id="@+id/btn_shuffle" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:alpha="0.6" android:src="@drawable/ic_browse" android:contentDescription="@null" />
                <ImageView android:id="@+id/btn_prev" android:layout_width="56dp" android:layout_height="56dp" android:padding="14dp" android:src="@drawable/ic_play" android:rotation="180" android:contentDescription="@null" />
                <ImageView android:id="@+id/btn_play" android:layout_width="72dp" android:layout_height="72dp" android:padding="20dp" android:background="@drawable/bg_card" android:src="@drawable/ic_play" android:contentDescription="@null" />
                <ImageView android:id="@+id/btn_next" android:layout_width="56dp" android:layout_height="56dp" android:padding="14dp" android:src="@drawable/ic_play" android:contentDescription="@null" />
                <ImageView android:id="@+id/btn_repeat" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:alpha="0.6" android:src="@drawable/ic_library" android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="8dp">
                <ImageView android:id="@+id/btn_video" android:layout_width="52dp" android:layout_height="52dp" android:padding="14dp" android:src="@drawable/ic_browse" android:contentDescription="@string/action_video" />
                <ImageView android:id="@+id/btn_fullscreen" android:layout_width="52dp" android:layout_height="52dp" android:padding="14dp" android:src="@drawable/ic_search" android:contentDescription="@string/action_fullscreen" />
                <ImageView android:id="@+id/btn_download" android:layout_width="52dp" android:layout_height="52dp" android:padding="14dp" android:src="@drawable/ic_library" android:contentDescription="@string/action_download" />
                <ImageView android:id="@+id/btn_fav" android:layout_width="52dp" android:layout_height="52dp" android:padding="14dp" android:src="@drawable/ic_home" android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout android:id="@+id/video_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:visibility="gone">
                <TextView android:id="@+id/video_hint" style="@style/Text.Row.Meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Чистое видео · двойной тап — полный экран" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
